#include <winres.h>
#include "@SVS_PRODUCT_VERSIONINFO_HEADER_FILE@"

LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT

#ifdef SVS_@SVS_UPPER_PROJECT_NAME@_HAS_ICON
	@SVS_UPPER_PROJECT_NAME@_LOGO ICON SVS_@SVS_UPPER_PROJECT_NAME@_ICON
#endif

VS_VERSION_INFO VERSIONINFO
    FILEVERSION SVS_@SVS_UPPER_PROJECT_NAME@_FILE_VERSION_RESOURCE
    PRODUCTVERSION SVS_@SVS_UPPER_PROJECT_NAME@_PRODUCT_VERSION_RESOURCE
    FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
    FILEFLAGS 0x1L
#else
    FILEFLAGS 0x0L
#endif
    FILEOS 0x40004L
    FILETYPE 0x0L
    FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", SVS_@SVS_UPPER_PROJECT_NAME@_PRODUCT_COMMENTS
            VALUE "CompanyName", SVS_@SVS_UPPER_PROJECT_NAME@_PRODUCT_COMPANY_NAME
            VALUE "FileDescription", SVS_@SVS_UPPER_PROJECT_NAME@_PRODUCT_FILE_DESCRIPTION
            VALUE "FileVersion", SVS_@SVS_UPPER_PROJECT_NAME@_FILE_VERSION_RESOURCE_STR
            VALUE "InternalName", SVS_@SVS_UPPER_PROJECT_NAME@_PRODUCT_INTERNAL_NAME
            VALUE "LegalCopyright", SVS_@SVS_UPPER_PROJECT_NAME@_PRODUCT_COMPANY_COPYRIGHT
            VALUE "OriginalFilename", SVS_@SVS_UPPER_PROJECT_NAME@_PRODUCT_ORIGINAL_FILENAME
            VALUE "ProductName", SVS_@SVS_UPPER_PROJECT_NAME@_PRODUCT_BUNDLE
            VALUE "ProductVersion", SVS_@SVS_UPPER_PROJECT_NAME@_PRODUCT_VERSION_RESOURCE_STR
        END
    END
	 BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

#!/bin/bash

cat << EO_TEXT_HEREDOC > /tmp/Sentient_EULA.txt
${EULA_CONTENT}
EO_TEXT_HEREDOC


less -X /tmp/Sentient_EULA.txt
rm -f /tmp/Sentient_EULA.txt
echo "By installing this software you agree to the terms and conditions outlined in this license."
echo "Press 'a' to agree or any other key to exit."

ans=""

while [ "$ans" == "" ]
do
	read -n 1 ans
done

if [ "$ans" != "a" ]; then
	echo ""
	echo "Aborting ..."
	exit 1
else
	echo ""
	echo "Installing  ..."
fi

${PREINST_CONTENT}

